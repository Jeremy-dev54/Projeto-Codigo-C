/*
  NEXUS ACCESS CONTROL 
  Central de seguranca simulada apenas com PORTAS LOGICAS.
 
  ENTRADAS (4)
    C = Cartao RFID autorizado
    H = Horario comercial (RTC: 08h <= hora < 18h)
    M = Sensor de movimento interno (PIR)
    P = Sensor magnetico: porta fisicamente aberta
 
  SAIDAS (4)
    S1 TRAVA  = C . H . /Q
    S2 SIRENE = Q  (latch: alarme memorizado ate o sistema ser rearmado)
    S3 LOG    = H . (TRAVA xor M)
    S4 CAMERA = ALARME_COND + LOG
 
  Equacoes booleanas:
    FORA_HORA   = /H
    FORCADA     = P . /TRAVA
    ALARME_COND = /H.(C+M+P) + FORCADA
    Q+          = ALARME_COND + Q          (latch: uma vez ligado, se mantem;
                                            o rearme e feito pelo menu)
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <errno.h>

#define EXPEDIENTE_INICIO 8
#define EXPEDIENTE_FIM    18   // exclusivo: 17:59 ainda e expediente

typedef int bit;               // sinal digital: 0 ou 1

// ------------ BIBLIOTECA DE PORTAS --------------
static bit NOT_(bit a)         { return !a; }
static bit AND_(bit a, bit b)  { return a && b; }
static bit OR_ (bit a, bit b)  { return a || b; }
static bit XOR_(bit a, bit b)  { return a != b; }
static bit NAND_(bit a, bit b) { return NOT_(AND_(a, b)); }
static bit NOR_ (bit a, bit b) { return NOT_(OR_(a, b)); }
static bit XNOR_(bit a, bit b) { return NOT_(XOR_(a, b)); }

// ESTRUTURAS
typedef struct {
    bit C, H, M, P;
} Entradas;

typedef struct {
    // intermediarios
    bit fora_hora;
    bit cred_ok;
    bit forcada;
    bit diverg;
    bit alarme_cond;   // alarme "ao vivo", sem memoria
    // saidas fisicas 
    bit trava;         // S1 
    bit sirene;        // S2 (latch)
    bit log_audit;     // S3 
    bit camera;        // S4 
} Saidas;

// NUCLEO LOGICO (so portas)
// q_prev = estado anterior do latch (memoria do alarme)
static Saidas avaliar(Entradas e, bit q_prev)
{
    Saidas s;

    s.fora_hora = NOT_(e.H);
    s.cred_ok   = AND_(e.C, e.H);

    // S1: credencial valida, em horario e sem bloqueio central
    s.trava = AND_(s.cred_ok, NOT_(q_prev));

    // porta aberta sem a trava ter sido liberada = arrombamento
    s.forcada = AND_(e.P, NOT_(s.trava));

    // divergencia entre o que o sistema liberou e o que o PIR viu
    s.diverg = XOR_(s.trava, e.M);

    // condicao de alarme (combinacional)
    s.alarme_cond = OR_(AND_(s.fora_hora, OR_(OR_(e.C, e.M), e.P)),
                        s.forcada);

    // S2: latch -> Q+ = SET + Q (se ja estava ligado, continua ligado)
    s.sirene = OR_(s.alarme_cond, q_prev);

    // S3: anomalia durante o expediente
    s.log_audit = AND_(e.H, s.diverg);

    // S4: grava sempre que houver alarme ou anomalia
    s.camera = OR_(s.alarme_cond, s.log_audit);

    return s;
}

// INTERFACE
static void linha(const char *fmt, ...)
{
    char buf[256];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(buf, sizeof buf, fmt, ap);
    va_end(ap);
    printf("| %-69s |\n", buf);
}

static void borda(void)
{
    printf("-------------------------------------------------------------------------\n");
}

static const char *diagnostico(Entradas e, Saidas s)
{
    if (s.forcada)
        return "ARROMBAMENTO: porta aberta sem liberacao da trava!";
    if (s.alarme_cond && e.C && e.M)
        return "VIOLACAO CRITICA: acesso fora de horario COM movimento interno!";
    if (s.alarme_cond && e.C)
        return "BLOQUEIO DE PERIODO: credencial valida recusada pelo relogio.";
    if (s.alarme_cond && (e.M || e.P))
        return "INTRUSAO: atividade na area restrita fora do expediente!";
    if (s.sirene)
        return "ALARME EM MEMORIA: bloqueio central ate rearmar o sistema (opcao 4).";
    if (s.log_audit && s.trava && !e.M)
        return "ALERTA XOR (TIMEOUT): credencial aceita, mas ninguem passou.";
    if (s.log_audit && !s.trava && e.M)
        return "ALERTA XOR: presenca interna sem credencial no expediente.";
    if (s.trava && e.M)
        return "ACESSO AUTORIZADO E CONFIRMADO.";
    return "STANDBY: perimetro seguro, sem eventos ativos.";
}

static void painel(Entradas e, int hora, Saidas s, bit q_prev)
{
    putchar('\n');
    borda();
    linha("NEXUS ACCESS CONTROL   |  TELEMETRIA EM TEMPO REAL");
    borda();
    linha("ENTRADAS  C=%d  H=%d [%02dh]  M=%d  P=%d  | Q_ant=%d",
          e.C, e.H, hora, e.M, e.P, q_prev);
    borda();
    linha("MALHA LOGICA");
    linha("  NOT   /H                    = %d   fora de expediente", s.fora_hora);
    linha("  AND   C.H                   = %d   credencial no horario", s.cred_ok);
    linha("  AND   P./TRAVA              = %d   porta forcada", s.forcada);
    linha("  XOR   TRAVA ^ M             = %d   divergencia fisica", s.diverg);
    linha("  OR    /H.(C+M+P)+FORCADA    = %d   condicao de alarme", s.alarme_cond);
    borda();
    linha("SAIDAS FISICAS");
    linha("  S1 TRAVA  : %d  %s", s.trava,
          s.trava ? "ENERGIZADA - PORTA LIBERADA" : "TRANCADA");
    linha("  S2 SIRENE : %d  %s", s.sirene,
          s.sirene ? "DISPARADA (memorizada no latch)" : "INATIVA - ARMADO");
    linha("  S3 LOG    : %d  %s", s.log_audit,
          s.log_audit ? "ALERTA SILENCIOSO AO GUARDA" : "OPERACAO PADRAO");
    linha("  S4 CAMERA : %d  %s", s.camera,
          s.camera ? "GRAVANDO EVENTO" : "STANDBY");
    borda();
    printf("\n[DIAGNOSTICO]: %s\n", diagnostico(e, s));
}

/*
   Le uma linha inteira, descarta o excedente se ela for maior que o buffer
   e so aceita se TODA a linha for um numero inteiro dentro de [min, max].
   Rejeita: letras, "1abc", linha vazia, numeros gigantes (overflow).
 */
static int lerInt(const char *msg, int min, int max)
{
    char buf[64];

    for (;;) {
        printf("%s", msg);
        if (!fgets(buf, sizeof buf, stdin)) {       
            printf("\n[ENTRADA ENCERRADA]\n");
            exit(0);
        }

        size_t n = strlen(buf);
        if (n > 0 && buf[n - 1] == '\n') {
            buf[n - 1] = '\0';
        } else {
            int ch;                                  // linha longa: descarta o resto
            while ((ch = getchar()) != '\n' && ch != EOF) { }
        }

        char *fim;
        errno = 0;
        long v = strtol(buf, &fim, 10);

        while (*fim == ' ' || *fim == '\t' || *fim == '\r') fim++;  // espacos finais ok

        if (fim != buf && *fim == '\0' && errno == 0 && v >= min && v <= max)
            return (int)v;

        printf("   Entrada invalida. Digite um numero inteiro entre %d e %d.\n",
               min, max);
    }
}

// MODO 1: SIMULACAO 
static void simular(bit *latch)
{
    Entradas e;
    int hora;

    e.C   = lerInt(" > RFID  - Cartao autorizado?  (1/0): ", 0, 1);
    hora  = lerInt(" > RTC   - Hora de entrada      (0-23): ", 0, 23);
    e.M   = lerInt(" > PIR   - Movimento interno?  (1/0): ", 0, 1);
    e.P   = lerInt(" > MAG   - Porta aberta?       (1/0): ", 0, 1);

    e.H = AND_(hora >= EXPEDIENTE_INICIO, hora < EXPEDIENTE_FIM);

    bit q_prev = *latch;
    Saidas s = avaliar(e, q_prev);
    *latch = s.sirene;                       // memoria entre ciclos
    painel(e, hora, s, q_prev);
}

// MODO 2: TABELA VERDADE COMPLETA 
static void tabelaVerdade(void)
{
    printf("\nTABELA VERDADE (16 combinacoes, latch inicial Q=0)\n");
    printf("+----+---+---+---+---++-------+--------+-----+--------+\n");
    printf("| #  | C | H | M | P || TRAVA | SIRENE | LOG | CAMERA |\n");
    printf("+----+---+---+---+---++-------+--------+-----+--------+\n");
    for (int i = 0; i < 16; i++) {
        Entradas e = { (i >> 3) & 1, (i >> 2) & 1, (i >> 1) & 1, i & 1 };
        Saidas s = avaliar(e, 0);
        printf("| %02d | %d | %d | %d | %d ||   %d   |   %d    |  %d  |   %d    |\n",
               i, e.C, e.H, e.M, e.P,
               s.trava, s.sirene, s.log_audit, s.camera);
    }
    printf("+----+---+---+---+---++-------+--------+-----+--------+\n");
}

// MODO 3: AUTO-VERIFICACAO LOGICA 
static int falhas, testes;

static void check(int cond, const char *nome)
{
    testes++;
    if (!cond) { falhas++; printf("  [FALHA] %s\n", nome); }
}

static void autoTeste(void)
{
    falhas = testes = 0;

    // 1. Identidades booleanas (De Morgan e XOR)
    for (bit a = 0; a <= 1; a++)
        for (bit b = 0; b <= 1; b++) {
            check(NAND_(a, b) == OR_(NOT_(a), NOT_(b)),  "De Morgan: NAND");
            check(NOR_(a, b)  == AND_(NOT_(a), NOT_(b)), "De Morgan: NOR");
            check(XOR_(a, b)  == OR_(AND_(a, NOT_(b)), AND_(NOT_(a), b)),
                  "XOR = A/B + /AB");
            check(XNOR_(a, b) == NOT_(XOR_(a, b)),       "XNOR = /XOR");
        }

    // 2. Invariantes de seguranca em todas as 16 entradas, para Q=0 e Q=1 
    for (bit q = 0; q <= 1; q++)
        for (int i = 0; i < 16; i++) {
            Entradas e = { (i >> 3) & 1, (i >> 2) & 1, (i >> 1) & 1, i & 1 };
            Saidas s = avaliar(e, q);
            check(!(s.trava && s.alarme_cond), "trava e alarme nunca juntos");
            check(!(s.trava && !e.H),          "trava nunca fora do horario");
            check(!(s.trava && q),             "bloqueio central tranca");
            check(!s.alarme_cond || s.camera,  "alarme sempre grava");
            check(!(s.alarme_cond) || s.sirene,"alarme sempre soa sirene");
        }

    // 3. Comportamento do latch: set, memoria e rearme 
    Entradas ocioso  = {0, 1, 0, 0};   // expediente, nada acontecendo
    Entradas intruso = {0, 0, 1, 0};   // fora de hora com movimento
    bit q = avaliar(intruso, 0).sirene;
    check(q == 1, "latch: SET por intrusao");
    q = avaliar(ocioso, q).sirene;
    check(q == 1, "latch: memoria mantem sirene");
    q = avaliar(ocioso, 0).sirene;          // apos rearmar (q = 0)
    check(q == 0, "latch: apos rearme, sem alarme, sirene desliga");

    printf("\nAUTO-TESTE: %d verificacoes, %d falha(s) -> %s\n",
           testes, falhas, falhas ? "REPROVADO" : "TODAS APROVADAS");
}

// MAIN 
int main(void)
{
    bit latch = 0;
    int op;

    printf("\n=====================================================================\n");
    printf("   NEXUS SECURITY SYSTEMS - SIMULADOR DE CONTROLE DE ACESSO \n");
    printf("=====================================================================\n");

    do {
        printf("\n[MENU]  1) Simular ciclo   2) Tabela verdade completa\n");
        printf("        3) Auto-teste logico   4) Rearmar sistema   0) Sair\n");
        op = lerInt("Opcao: ", 0, 4);

        switch (op) {
            case 1: simular(&latch);   break;
            case 2: tabelaVerdade();   break;
            case 3: autoTeste();       break;
            case 4: latch = 0; printf("\nSistema rearmado: alarme zerado.\n"); break;
            default: break;
        }
    } while (op != 0);

    printf("\n[SISTEMA ENCERRADO] Sessao de telemetria finalizada.\n");
    return 0;
}
